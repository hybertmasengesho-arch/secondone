# Copy this file to .env and fill in real values before running locally.
# cp .env.example .env

PORT=4000

# Supabase → Project Settings → API. Use the SERVICE ROLE key (not anon/public) —
# the server needs full access and bypasses Row Level Security. Never expose
# this key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Any long random string, used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated emails that get admin access automatically on register/login.
ADMIN_EMAILS=
